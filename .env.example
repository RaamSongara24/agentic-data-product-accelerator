# Application
APP_NAME=agentic-data-product
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (matches docker-compose.yml defaults)
# Used for application data, artefacts, audit, lineage, and LangGraph checkpointer.
DATABASE_URL=postgresql+asyncpg://adp:adp@localhost:5432/adp

# LLM (M3+) — secrets via env only; never stored in graph state
# deterministic (default, offline MVP demo) | openai_compatible
LLM_PROVIDER=deterministic
# LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# Mapping judge retry caps
MAPPING_SCHEMA_RETRY_CAP=2
MAPPING_LOGIC_RETRY_CAP=2
